            "exec": [
              "const resp = pm.response.json();",
              "console.log('Status response:', JSON.stringify(resp, null, 2));",
              "",
              "pm.test('Status returns 200xx', function () {",
              "    pm.expect(resp.responseCode).to.match(/^200/);",
              "});",
              "",
              "const data = resp.virtualAccountData || {};",
              "const flag = data.paymentFlagStatus;",
              "",
              "let meaning = 'UNKNOWN — not one of the four documented flags';",
              "if (flag === '00') { meaning = 'Success payment flag'; }",
              "if (flag === '01') { meaning = 'Reject payment flag by partner'; }",
              "if (flag === '02') { meaning = 'Timeout switcher-to-partner (stored as 00 when this partner reconciliation type is reversal / force_settle)'; }",
              "if (flag === '03') { meaning = 'Pending between BCA and the partner'; }",
              "console.log('paymentFlagStatus:', flag, '->', meaning);",
              "",
              "pm.test('paymentFlagStatus is one of 00/01/02/03', function () {",
              "    pm.expect(['00', '01', '02', '03']).to.include(flag);",
              "});",
              "",
              "// The response deliberately says NOTHING about whether BCA was reached — a",
              "// bank outage degrades to the stored answer by design, so a 200 here is not",
              "// evidence the bank was consulted. Read the server log for that:",
              "//   docker compose logs -f app | grep reconcile"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
