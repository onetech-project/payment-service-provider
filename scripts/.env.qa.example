# Config for scripts/qa.sh, the UAT test runner.
#
#   cp scripts/.env.qa.example scripts/.env.qa
#
# That copy is gitignored (.env.* is), which matters because the credential
# files it points at hold live UAT secrets. Nothing here is a secret itself —
# only paths to the files that are.
#
# Every value below has a default, so an empty .env.qa still works against UAT.
# Check the whole setup with:
#
#   ./scripts/qa.sh doctor

# --- target ---
QA_BASE_URL=https://uatbca.manjo.co.id

# --- credentials ---
# Two DIFFERENT credentials, and qa.sh picks between them per command:
#
#   merchant  create-va, list, list-transactions, delete-va
#   vendor    inquiry, payment, status
#
# Swapping them fails as "Unauthorized. [Invalid signature]", which reads like
# a signing bug rather than a wrong file — qa.sh checks the key prefixes up
# front and says so plainly instead. Paths are repo-root-relative or absolute.
#
# Produced by ./scripts/onboard-merchant.sh and ./scripts/onboard-vendor.sh.
QA_MERCHANT_ENV=.env.merchant.uatbca
QA_VENDOR_ENV=.env.uatbca.va

# --- test data defaults ---
# 15973 / 15974 / 15975 are reserved in master_partner_service_ids for the
# no-bill / variable-bill / fixed-bill VA types, and a create-va against one of
# them is rejected unless QA_VA_TYPE agrees. Use an unreserved id for a VA that
# is not type-managed.
QA_PARTNER_SERVICE_ID=15975

# 01 no-bill static     02 variable static     03 fixed static
# 04 no-bill dynamic    05 variable dynamic    06 fixed dynamic
QA_VA_TYPE=03

QA_AMOUNT=250000.00
QA_VA_NAME=QA Tester

# --- run logs ---
# When set, every command's full output is also written to
# $QA_LOG_DIR/qa-<command>-<timestamp>.log, so a test session leaves evidence
# without anyone having to redirect output by hand. Unset by default.
#QA_LOG_DIR=./qa-logs
