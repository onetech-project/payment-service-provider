# Copy to scripts/deploy/.env.deploy and fill in. That file is gitignored.
#
#   cp scripts/deploy/.env.deploy.example scripts/deploy/.env.deploy

# --- container registry ---
REGISTRY_PATH=registry.example.com
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# --- target environment ---
# uat or prod. Becomes the default image tag and the APP_ENV the remote compose
# stack is brought up with. The --env flag overrides it.
APP_ENV=uat

# --- image ---
# Left unset, TAG defaults to $APP_ENV — so uat and prod get distinct tags
# instead of fighting over :latest. Set it (or pass --tag) to pin a release.
#TAG=1.0.0-rc1

# Registry repository name for the API image.
IMAGE_NAME=payment-service-provider

# Service names in the server's docker-compose.yml. These are not the same
# string as IMAGE_NAME — compose calls the API container "app".
COMPOSE_SERVICE=app
MIGRATE_SERVICE=migrate

# --- remote server ---
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Leave SSH_PASSWORD empty to use key-based auth (recommended).
# If set, sshpass must be installed locally.
SSH_PASSWORD=

# Directory on the server holding docker-compose.yml. Its `app` service must
# use `image: $REGISTRY_PATH/$IMAGE_NAME:$TAG` — the repo's own
# docker-compose.yml builds from source instead, which `docker compose pull`
# cannot use.
REMOTE_DIR=/opt/bb-bca-va-uat

# --- migrations ---
# Uploaded before the stack comes up, because docker-compose.yml bind-mounts
# ./db/migrations into the migrate/migrate container rather than reading them
# from the image. Defaults to <repo>/db/migrations -> $REMOTE_DIR/db/migrations.
#LOCAL_MIGRATIONS_DIR=
#REMOTE_MIGRATIONS_DIR=

# --- vendor config (only uploaded with --config) ---
# Space-separated, repo-root-relative paths, extracted on the server under
# $REMOTE_DIR with their paths preserved. .env.* and *.pem are excluded by both
# .gitignore and .dockerignore, so the server copy is the only one that exists.
#
# Any VENDOR_PRIVATE_KEY_PATH / VENDOR_PUBLIC_KEY_PATH inside these files must
# be a path *inside the app container* (CONFIG_DIR is /config there), not the
# absolute workstation path used for local runs.
#DEPLOY_CONFIG_FILES=".env.bca.va client_private.pem client_public.pem"
