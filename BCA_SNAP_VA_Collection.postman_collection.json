	"item": [
		{
			"name": "1. Get Access Token",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// ---- B2B Token: RSA-SHA256 asymmetric signature ----",
							"const forge = require('node-forge');",
							"",
							"const timestamp = new Date().toISOString().replace(/\\.\\d{3}Z$/, '+07:00');",
							"const clientId = pm.collectionVariables.get('client_id');",
							"const privateKeyPem = pm.collectionVariables.get('private_key');",
							"",
							"if (!privateKeyPem || privateKeyPem === 'PASTE_YOUR_PRIVATE_KEY_PEM_HERE') {",
							"    throw new Error('Please set the private_key collection variable with your PEM content');",
							"}",
							"",
							"// stringToSign = clientId|timestamp",
							"const stringToSign = clientId + '|' + timestamp;",
							"",
							"// Sign with SHA256withRSA",
							"const privateKey = forge.pki.privateKeyFromPem(privateKeyPem);",
							"const md = forge.md.sha256.create();",
							"md.update(stringToSign, 'utf8');",
							"const signature = forge.util.encode64(privateKey.sign(md));",
							"",
							"pm.collectionVariables.set('timestamp', timestamp);",
							"",
							"pm.request.headers.upsert({ key: 'X-TIMESTAMP', value: timestamp });",
							"pm.request.headers.upsert({ key: 'X-SIGNATURE', value: signature });",
							"",
							"console.log('stringToSign:', stringToSign);",
							"console.log('X-TIMESTAMP:', timestamp);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Auto-save access token to collection variable",
							"const resp = pm.response.json();",
							"if (resp.accessToken) {",
							"    pm.collectionVariables.set('access_token', resp.accessToken);",
							"    console.log('✅ Access token saved to collection variable!');",
							"} else {",
							"    console.log('❌ No accessToken in response:', JSON.stringify(resp));",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "X-CLIENT-KEY", "value": "{{client_id}}" },
					{ "key": "X-TIMESTAMP", "value": "{{timestamp}}" },
					{ "key": "X-SIGNATURE", "value": "auto-set-by-pre-request-script" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"grantType\": \"client_credentials\",\n  \"additionalInfo\": {}\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{base_url}}/openapi/v1.0/access-token/b2b",
					"host": ["{{base_url}}"],
					"path": ["openapi", "v1.0", "access-token", "b2b"]
				},
				"description": "Get a Bearer access token (valid for 15 minutes).\n\nThe pre-request script auto-computes the RSA-SHA256 signature.\nThe test script auto-saves the token to `access_token` collection variable."
			},
			"response": []
		},
		{
			"name": "2. Inquiry VA",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// ---- SNAP Symmetric Signature (HMAC-SHA512) ----",
							"const timestamp = new Date().toISOString().replace(/\\.\\d{3}Z$/, '+07:00');",
							"const externalId = Date.now().toString() + Math.floor(Math.random() * 9000 + 1000);",
							"const inquiryRequestId = 'INQ-' + Date.now() + Math.floor(Math.random() * 9000 + 1000);",
							"",
							"pm.collectionVariables.set('timestamp', timestamp);",
							"pm.collectionVariables.set('inquiry_request_id', inquiryRequestId);",
							"",
							"const partnerServiceId = pm.collectionVariables.get('partner_service_id');",
							"const customerNo = pm.collectionVariables.get('customer_no');",
							"const virtualAccountNo = pm.collectionVariables.get('virtual_account_no');",
							"const amount = pm.collectionVariables.get('amount');",
							"",
							"// Build the EXACT body that will be sent (minified JSON)",
							"const body = JSON.stringify({",
							"    partnerServiceId: partnerServiceId,",
							"    customerNo: customerNo,",
							"    virtualAccountNo: virtualAccountNo,",
							"    txnDateInit: timestamp,",
							"    amount: { value: amount, currency: 'IDR' },",
							"    inquiryRequestId: inquiryRequestId",
							"});",
							"",
							"// SHA-256 hash of the body (standard base64)",
							"const bodyHash = CryptoJS.SHA256(body).toString(CryptoJS.enc.Base64);",
							"",
							"// stringToSign = METHOD:ENDPOINT:ACCESS_TOKEN:SHA256(BODY):TIMESTAMP",
							"const accessToken = pm.collectionVariables.get('access_token');",
							"if (!accessToken) {",
							"    throw new Error('No access_token — run \"1. Get Access Token\" first');",
							"}",
							"const endpoint = '/openapi/v1.0/transfer-va/inquiry';",
							"const stringToSign = 'POST:' + endpoint + ':' + accessToken + ':' + bodyHash + ':' + timestamp;",
							"",
							"// HMAC-SHA512 signature (standard base64)",
							"const clientSecret = pm.collectionVariables.get('client_secret');",
							"const signature = CryptoJS.HmacSHA512(stringToSign, clientSecret).toString(CryptoJS.enc.Base64);",
							"",
							"pm.request.headers.upsert({ key: 'X-TIMESTAMP', value: timestamp });",
							"pm.request.headers.upsert({ key: 'X-SIGNATURE', value: signature });",
							"pm.request.headers.upsert({ key: 'X-EXTERNAL-ID', value: externalId });",
							"",
							"// CRITICAL: overwrite the body with the exact bytes that were signed",
							"pm.request.body.raw = body;",
							"",
							"console.log('inquiryRequestId:', inquiryRequestId);",
							"console.log('bodyHash:', bodyHash);",
							"console.log('stringToSign:', stringToSign);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const resp = pm.response.json();",
							"console.log('Inquiry response:', JSON.stringify(resp, null, 2));",
							"",
							"pm.test('Inquiry returns 200xx', function () {",
							"    pm.expect(resp.responseCode).to.match(/^200/);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{access_token}}" },
					{ "key": "X-TIMESTAMP", "value": "{{timestamp}}" },
					{ "key": "X-SIGNATURE", "value": "auto-set-by-pre-request-script" },
					{ "key": "X-PARTNER-ID", "value": "{{partner_id}}" },
					{ "key": "X-EXTERNAL-ID", "value": "auto-set-by-pre-request-script" },
					{ "key": "CHANNEL-ID", "value": "{{channel_id}}" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"partnerServiceId\": \"{{partner_service_id}}\",\n  \"customerNo\": \"{{customer_no}}\",\n  \"virtualAccountNo\": \"{{virtual_account_no}}\",\n  \"txnDateInit\": \"{{timestamp}}\",\n  \"amount\": {\n    \"value\": \"{{amount}}\",\n    \"currency\": \"IDR\"\n  },\n  \"inquiryRequestId\": \"{{inquiry_request_id}}\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{base_url}}/openapi/v1.0/transfer-va/inquiry",
					"host": ["{{base_url}}"],
					"path": ["openapi", "v1.0", "transfer-va", "inquiry"]
				},
				"description": "Inquiry VA bill details before payment.\n\nThe pre-request script:\n1. Generates unique inquiryRequestId\n2. Builds the minified JSON body\n3. Computes SHA-256 hash of the body\n4. Signs with HMAC-SHA512\n5. Overwrites the body with exact signed bytes\n\n⚠️ Do NOT manually edit the Body tab — the pre-request script overwrites it."
			},
			"response": []
		},
		{
			"name": "3. Payment VA",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// ---- SNAP Symmetric Signature (HMAC-SHA512) ----",
							"const timestamp = new Date().toISOString().replace(/\\.\\d{3}Z$/, '+07:00');",
							"const externalId = Date.now().toString() + Math.floor(Math.random() * 9000 + 1000);",
							"const paymentRequestId = 'PAY-' + Date.now() + Math.floor(Math.random() * 9000 + 1000);",
							"const referenceNo = 'R' + Date.now().toString().slice(-9);",
							"",
							"pm.collectionVariables.set('timestamp', timestamp);",
							"pm.collectionVariables.set('payment_request_id', paymentRequestId);",
							"pm.collectionVariables.set('reference_no', referenceNo);",
							"",
							"const partnerServiceId = pm.collectionVariables.get('partner_service_id');",
							"const customerNo = pm.collectionVariables.get('customer_no');",
							"const virtualAccountNo = pm.collectionVariables.get('virtual_account_no');",
							"const trxId = pm.collectionVariables.get('trx_id');",
							"const amount = pm.collectionVariables.get('amount');",
							"",
							"// Build the EXACT body that will be sent (minified JSON)",
							"const body = JSON.stringify({",
							"    partnerServiceId: partnerServiceId,",
							"    customerNo: customerNo,",
							"    virtualAccountNo: virtualAccountNo,",
							"    trxId: trxId,",
							"    paymentRequestId: paymentRequestId,",
							"    paidAmount: { value: amount, currency: 'IDR' },",
							"    totalAmount: { value: amount, currency: 'IDR' },",
							"    trxDateTime: timestamp,",
							"    referenceNo: referenceNo",
							"});",
							"",
							"// SHA-256 hash of the body (standard base64)",
							"const bodyHash = CryptoJS.SHA256(body).toString(CryptoJS.enc.Base64);",
							"",
							"// stringToSign = METHOD:ENDPOINT:ACCESS_TOKEN:SHA256(BODY):TIMESTAMP",
							"const accessToken = pm.collectionVariables.get('access_token');",
							"if (!accessToken) {",
							"    throw new Error('No access_token — run \"1. Get Access Token\" first');",
							"}",
							"const endpoint = '/openapi/v1.0/transfer-va/payment';",
							"const stringToSign = 'POST:' + endpoint + ':' + accessToken + ':' + bodyHash + ':' + timestamp;",
							"",
							"// HMAC-SHA512 signature (standard base64)",
							"const clientSecret = pm.collectionVariables.get('client_secret');",
							"const signature = CryptoJS.HmacSHA512(stringToSign, clientSecret).toString(CryptoJS.enc.Base64);",
							"",
							"pm.request.headers.upsert({ key: 'X-TIMESTAMP', value: timestamp });",
							"pm.request.headers.upsert({ key: 'X-SIGNATURE', value: signature });",
							"pm.request.headers.upsert({ key: 'X-EXTERNAL-ID', value: externalId });",
							"",
							"// CRITICAL: overwrite the body with the exact bytes that were signed",
							"pm.request.body.raw = body;",
							"",
							"console.log('paymentRequestId:', paymentRequestId);",
							"console.log('bodyHash:', bodyHash);",
							"console.log('stringToSign:', stringToSign);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const resp = pm.response.json();",
							"console.log('Payment response:', JSON.stringify(resp, null, 2));",
							"",
							"pm.test('Payment returns 200xx', function () {",
							"    pm.expect(resp.responseCode).to.match(/^200/);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{access_token}}" },
					{ "key": "X-TIMESTAMP", "value": "{{timestamp}}" },
					{ "key": "X-SIGNATURE", "value": "auto-set-by-pre-request-script" },
					{ "key": "X-PARTNER-ID", "value": "{{partner_id}}" },
					{ "key": "X-EXTERNAL-ID", "value": "auto-set-by-pre-request-script" },
					{ "key": "CHANNEL-ID", "value": "{{channel_id}}" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"partnerServiceId\": \"{{partner_service_id}}\",\n  \"customerNo\": \"{{customer_no}}\",\n  \"virtualAccountNo\": \"{{virtual_account_no}}\",\n  \"trxId\": \"{{trx_id}}\",\n  \"paymentRequestId\": \"{{payment_request_id}}\",\n  \"paidAmount\": {\n    \"value\": \"{{amount}}\",\n    \"currency\": \"IDR\"\n  },\n  \"totalAmount\": {\n    \"value\": \"{{amount}}\",\n    \"currency\": \"IDR\"\n  },\n  \"trxDateTime\": \"{{timestamp}}\",\n  \"referenceNo\": \"{{reference_no}}\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{base_url}}/openapi/v1.0/transfer-va/payment",
					"host": ["{{base_url}}"],
					"path": ["openapi", "v1.0", "transfer-va", "payment"]
				},
				"description": "Send payment notification against a VA.\n\nThe pre-request script:\n1. Generates unique paymentRequestId & referenceNo\n2. Builds the minified JSON body\n3. Computes SHA-256 hash of the body\n4. Signs with HMAC-SHA512\n5. Overwrites the body with exact signed bytes\n\n⚠️ Do NOT manually edit the Body tab — the pre-request script overwrites it.\n\n**Note:** If the VA was already paid, you'll get 4092500 Conflict. Create a new VA first."
			},
			"response": []
		}
	]
}
