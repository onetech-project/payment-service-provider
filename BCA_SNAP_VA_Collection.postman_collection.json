{
	"info": {
		"_postman_id": "bca-snap-va-collection",
		"name": "BCA SNAP VA - Inquiry & Payment",
		"description": "Collection for testing BCA SNAP Virtual Account endpoints.\n\n**Setup:**\n1. Import this collection\n2. Fill in `private_key` collection variable with your full PEM content\n3. Run requests in order: Token → Inquiry → Payment\n\n**Signature is auto-computed** by the pre-request scripts — no manual signing needed.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://uatbca.manjo.co.id",
			"type": "string"
		},
		{
			"key": "client_id",
			"value": "a9612651-9181-4461-af20-4ef6598a93f5",
			"type": "string"
		},
		{
			"key": "client_secret",
			"value": "1c19e3313badc5068995ca0b42a4938e96ae57ca1c57ad13cfeed728a9ceb15a",
			"type": "string"
		},
		{
			"key": "private_key",
			"value": "PASTE_YOUR_PRIVATE_KEY_PEM_HERE",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
