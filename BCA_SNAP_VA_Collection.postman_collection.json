			"value": "66666666",
			"type": "string"
		},
		{
			"key": "virtual_account_no",
			"value": "1597366666666",
			"type": "string"
		},
		{
			"key": "trx_id",
			"value": "cmscyczsl00061wryys7zli68",
			"type": "string"
		},
		{
			"key": "amount",
			"value": "150000.00",
			"type": "string"
		},
		{
			"key": "timestamp",
			"value": "",
			"type": "string"
		},
		{
			"key": "inquiry_request_id",
			"value": "",
