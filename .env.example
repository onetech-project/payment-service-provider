# Global Configuration for Payment Gateway
# Copy this file to .env and update values

# ============================================================
# Server Configuration
# ============================================================
PORT=8080
# Comma-separated list of allowed CORS origins (e.g. https://dashboard.example.com,https://admin.example.com).
# Leave empty to disable CORS (cross-origin browser requests will be blocked).
CORS_ALLOWED_ORIGINS=
# Comma-separated list of allowed CORS request headers. Leave empty to use the
# built-in default (cmd/api/main.go defaultCORSHeaders): Origin, Content-Type,
# Accept, Authorization, Authorization-Customer, the SNAP headers
# X-TIMESTAMP/X-SIGNATURE/X-CLIENT-KEY/X-PARTNER-ID/X-EXTERNAL-ID/CHANNEL-ID,
# the B2B2C/device headers X-ORIGIN/X-IP-ADDRESS/X-DEVICE-ID/X-LATITUDE/
# X-LONGITUDE, and X-Admin-API-Key.
# If you override it, keep it a SUPERSET of what your browser clients send: a
# header named in the preflight but absent here makes the browser block the
# request even when the origin is allowed.
CORS_ALLOWED_HEADERS=

# ============================================================
# Database Configuration (PostgreSQL)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payment_gateway
DB_SSLMODE=disable

# ============================================================
# Redis Configuration
# ============================================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
# Timeout for the initial Redis PING on startup
REDIS_CONNECT_TIMEOUT_SECONDS=1

# ============================================================
# Idempotency Middleware Configuration
# ============================================================
# How long a concurrent duplicate request is held off while the original
# (same Idempotency-Key) is still being processed.
IDEMPOTENCY_LOCK_TTL_SECONDS=30
# How long a completed response is replayed for a repeated Idempotency-Key.
IDEMPOTENCY_CACHE_TTL_SECONDS=86400

# ============================================================
# Asynq Queue Configuration
# ============================================================
ASYNQ_REDIS_ADDR=localhost:6379
ASYNQ_REDIS_PASSWORD=
ASYNQ_REDIS_DB=1
ASYNQ_CONCURRENCY=10

# ============================================================
# Telemetry Configuration (OpenTelemetry)
# ============================================================
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================
# Configuration Directory
# ============================================================
CONFIG_DIR=.

# ============================================================
# Logging (consumed by internal/adapter/delivery/http/middleware/telemetry.go)
# ============================================================
# debug|info|warn|error, defaults to info if unset/unrecognized
LOG_LEVEL=info
# json (default, structured — required for Loki/Alloy field parsing) or text
LOG_FORMAT=json

# ============================================================
# Admin API Key (for /admin endpoints)
# ============================================================
ADMIN_API_KEY=changeme

# ============================================================
# Merchant signature: legacy body-hash acceptance
# ============================================================
# Merchant X-SIGNATURE now hashes the MINIFIED request body —
# base64(SHA-256(MinifyJson(body))) — matching the vendor side and SNAP. The
# two middlewares used to disagree, so the same body signed correctly for a
# vendor endpoint was a 401 on a merchant endpoint.
#
# While this is "true" the previous raw-body digest is also accepted, so no
# merchant breaks at deploy time. The change is only observable for merchants
# that send whitespace-bearing JSON: for a compact body MinifyJson is a no-op
# and both digests are identical. Set to "false" once every merchant has
# migrated — leaving it on indefinitely keeps a second valid signature alive
# for every request.
MERCHANT_LEGACY_BODY_HASH=true

# ============================================================
# Vendor status reconciliation (feature 014)
# ============================================================
# Periodically asks the vendor's SNAP Inquiry Status service (code 26) what
# really happened to transactions this service still records as pending.
#
# This is the recovery path for the one failure the inbound endpoints cannot
# survive: a /payment call that never arrives. A failed merchant callback has
# resend-callback, and a lost /payment RESPONSE is retried by the vendor with
# flagAdvise=Y — but if the call itself never lands, this service holds no
# evidence that anything happened. The customer's money is taken, the merchant
# is never told, and nothing here knows to look. Only the vendor can say.
#
# Off by default because it makes OUTBOUND calls: it must not start running the
# moment someone deploys this build. Enabling it also requires the target
# vendor's config to carry VENDOR_BASE_URL, VENDOR_CLIENT_ID and
# VENDOR_PRIVATE_KEY_PATH (the RSA key we sign OUR token requests with — not
# VENDOR_CLIENT_SECRET, which verifies what the vendor sends us). Startup logs
# exactly which of these is missing and stays disabled rather than failing
# every sweep forever.
RECONCILE_ENABLED=false
# Which configured vendor/channel to reconcile against, i.e. whose
# config/.env.<vendor>.<channel> supplies the outbound connection.
RECONCILE_VENDOR=bca
RECONCILE_CHANNEL=va
# How long a transaction must have been pending before it is worth asking
# about. Too short and the sweep interrogates the vendor about VAs nobody has
# tried to pay yet; too long and money sits unrecorded.
RECONCILE_PENDING_AFTER_MINUTES=15
# How often the sweep runs. Scheduled through Asynq, which elects a single
# active scheduler via Redis — so one sweep per interval regardless of how many
# replicas are deployed.
RECONCILE_INTERVAL_MINUTES=5
# Cap on transactions reconciled per sweep, so a backlog drains steadily
# instead of firing thousands of calls at the vendor at once.
RECONCILE_BATCH_SIZE=100

# ============================================================
# Application Environment
# ============================================================
APP_ENV=dev