# Vendor Channel Configuration Template
# Copy this file to .env.<vendor>.<channel> (e.g., .env.bca.va, .env.bri.va, .env.mandiri.va)
# All variables use VENDOR_ prefix for vendor-specific settings

# ============================================================
# Vendor Identification
# ============================================================
# VENDOR_NAME=<vendor>       # e.g., bca, bri, mandiri
# VENDOR_CHANNEL=<channel>   # e.g., va, qris, transfer

# ============================================================
# Authentication
# ============================================================
VENDOR_CLIENT_ID=
VENDOR_CLIENT_SECRET=

# ============================================================
# Base URL (per environment)
# ============================================================
# Sandbox / UAT
VENDOR_BASE_URL=https://sandbox.<vendor>.co.id
# Production (uncomment for production)
# VENDOR_BASE_URL=https://www.<vendor>.co.id
#
# For BCA specifically the hosts are https://devapi.klikbca.com (UAT) and
# https://api.klikbca.com (production), per Tech. Doc. OpenAPI
# VA-Payment-Status API V2 v1.0.

# ============================================================
# Token Endpoint
# ============================================================
VENDOR_TOKEN_ENDPOINT=/openapi/v1.0/access-token/b2b

# ============================================================
# API Endpoints (ENDPOINT_NAME=url format)
# Add/remove endpoints based on vendor API
#
# These are paths on the VENDOR's host, used for calls this service
# originates. They are also what gets signed: the relative URL component of
# stringToSign is this exact string, so a path that is wrong here produces a
# wrong signature as well as a wrong URL.
#
# STATUS sits at v2.0, not v1.0. Developer API BCA hosts the inquiry-status
# service (code 26) at POST /openapi/v2.0/transfer-va/status while inquiry and
# payment stay at v1.0 — and unlike those two, status runs partner→BCA, so this
# is the one path here that a real BCA integration actually calls.
# ============================================================
VENDOR_ENDPOINT_INQUIRY=/openapi/v1.0/transfer-va/inquiry
VENDOR_ENDPOINT_STATUS=/openapi/v2.0/transfer-va/status
VENDOR_ENDPOINT_PAYMENT=/openapi/v1.0/transfer-va/payment

# ============================================================
# Channel Configuration
# ============================================================
VENDOR_CHANNEL_ID=
VENDOR_PARTNER_ID=
VENDOR_ORIGIN=yourdomain.com

# ============================================================
# Request Configuration
# ============================================================
VENDOR_REQUEST_TIMEOUT=30
VENDOR_SIGNATURE_ALGORITHM=HMAC-SHA512

# ============================================================
# SNAP Headers (comma-separated list of required headers)
# Per ASPI spec, transfer-va endpoints only require X-TIMESTAMP, X-SIGNATURE,
# X-PARTNER-ID, X-EXTERNAL-ID. X-CLIENT-KEY is NOT part of this list — it is
# only used on the access-token endpoint. CHANNEL-ID is `required: false` in
# the spec; only add it here if your specific vendor contractually requires it.
# ============================================================
VENDOR_REQUIRED_HEADERS=X-TIMESTAMP,X-SIGNATURE,X-PARTNER-ID,X-EXTERNAL-ID

# ============================================================
# Response Code Format
# ============================================================
VENDOR_RESPONSE_CODE_FORMAT=AAABBCC

# ============================================================
# Defaults
# ============================================================
VENDOR_DEFAULT_SUB_COMPANY=00000
VENDOR_DEFAULT_CHANNEL_CODE=6011

# ============================================================
# Logging
# ============================================================
VENDOR_DEBUG_LOGGING=false
VENDOR_CORRELATION_HEADER=X-Correlation-ID

# Body-hash encoding for stringToSign: hex (BCA/SNAP spec) | base64
VENDOR_BODY_HASH_ENCODING=hex
# Enforce BCA-mandatory payment fields: true | false
VENDOR_STRICT_MANDATORY_FIELDS=true
